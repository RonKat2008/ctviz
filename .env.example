OPENAI_API_KEY=
OPENROUTER_API_KEY=
PLANNER_MODE=live
PLANNER_MODEL=gpt-5.4-mini
PLANNER_REASONING_EFFORT=low
JUDGE_MODEL=google/gemini-2.5-flash-lite
# Rate limits for POST /v1/visualize (0 disables): per client IP per minute, global per day.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=500
# Only behind a proxy you control: take the client IP from X-Forwarded-For.
RATE_LIMIT_TRUST_FORWARDED_FOR=false
APP_URL=http://localhost:8000
APP_NAME=ctviz
